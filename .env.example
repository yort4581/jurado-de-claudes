# Copia este archivo a .env y rellena tu clave: https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Opcional. Modelos por defecto: el jurado usa el modelo barato y rápido;
# fiscal, defensor y juez usan el modelo intermedio.
# JURADO_MODELO_PRINCIPAL=claude-sonnet-5-5
# JURADO_MODELO_JURADO=claude-haiku-5-5

# Cuántas llamadas a la API pueden ir a la vez (los 12 jurados votan en paralelo).
# JURADO_MAX_PARALELO=6

# Pon 1 para probar la interfaz sin API key ni gasto de tokens.
# JURADO_MOCK=0
